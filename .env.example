# App
NEXTAUTH_URL=https://spotify-clone-iota-pink.vercel.app
NEXT_PUBLIC_APP_URL=https://spotify-clone-iota-pink.vercel.app

# Auth — set JWT_SECRET in Vercel. NEXTAUTH_SECRET is an optional alias.
JWT_SECRET=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
MONGODB_URL=
MONGODB_URI=
DB_NAME=

# Email
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Optional: official YouTube Data API. Search still works without it.
YOUTUBE_API_KEY=
