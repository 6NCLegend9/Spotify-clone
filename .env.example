# App — production/Vercel values. Both must be this exact canonical origin.
NEXTAUTH_URL=https://haykasa.vercel.app
NEXT_PUBLIC_APP_URL=https://haykasa.vercel.app
# Local development: set both values in the ignored .env file to the same
# loopback origin and actual port, for example http://localhost:3003.
# Never point a local HTTP server at a production or preview NEXTAUTH_URL.

# Auth — generate unique high-entropy values in Vercel; never commit real values.
JWT_SECRET=
NEXTAUTH_SECRET=
# Used to HMAC rate-limit identifiers. Required in production.
RATE_LIMIT_SECRET=
# Optional. Leave both Google values empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Atlas — required. Allow Vercel egress in Atlas Network Access.
MONGODB_URL=
MONGODB_URI=
DB_NAME=

# SMTP — required for signup verification and password reset.
# Email addresses are not restricted by provider. Delivery to Gmail, Outlook,
# Yahoo, iCloud, Proton, and other domains depends on sender reputation and DNS.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Optional monitored mailbox for account-deletion notices.
MONITORED_INBOX=

# Optional: official YouTube Data API. Search still works without it.
YOUTUBE_API_KEY=

# Discord Rich Presence — create an app at https://discord.com/developers/applications
# Add RPC Origins and Redirects for https://haykasa.vercel.app and http://localhost:3003
# Add yourself as an RPC tester until Discord approves the app.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated emails allowed into the Beat Arcade preview. Empty = open to everyone.
NEXT_PUBLIC_ARCADE_ALLOWED_EMAILS=

# Jam (realtime). Required for the global Jam button. Restart the dev server after changing these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
