# App — set both to the canonical HTTPS production URL in Vercel.
NEXTAUTH_URL=https://haykasa.vercel.app
NEXT_PUBLIC_APP_URL=https://haykasa.vercel.app

# Auth — generate unique high-entropy values in Vercel; never commit real values.
JWT_SECRET=
NEXTAUTH_SECRET=
# Used to HMAC rate-limit identifiers. Required in production.
RATE_LIMIT_SECRET=
# Optional. Leave both Google values empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Atlas — required. Allow Vercel egress in Atlas Network Access.
MONGODB_URL=
MONGODB_URI=
DB_NAME=

# SMTP — required for signup verification and password reset.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Optional monitored mailbox for account-deletion notices.
MONITORED_INBOX=

# Optional: official YouTube Data API. Search still works without it.
YOUTUBE_API_KEY=
